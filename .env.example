# Copy to .env (gitignored) and fill in:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-only-change-me-before-deploy"
# Windows dev networks that blackhole IPv6 need this in every terminal
# before node/npm commands (or the Neon pooler connection hangs):
#   $env:NODE_OPTIONS="--dns-result-order=ipv4first"
