generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---- App models (mirror data/*.json pipeline) ----
model Source {
  id        String  @id @default(cuid())
  name      String  @unique
  feed      String
  expertise String
  score     Float
  stories   Story[]
}

model Story {
  id          String   @id @default(cuid())
  title       String
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id])
  author      String?
  publishedAt DateTime
  url         String   @unique
  type        String
  summary     String
  category    String
  bucket      String
  crossover   Boolean  @default(false)
  quality     Float
  aiWhy       String?
  aiBg        String?
  aiModel     String?
  importedAt  DateTime @default(now())
}

// Local reader profile (mirrors the app.html localStorage registry)
model Reader {
  id        String  @id @default(cuid())
  email     String  @unique
  interests String  @default("[]")
  fam       String  @default("some")
  bal       String  @default("balanced")
  follows   String  @default("")
  alerts    Boolean @default(true)
}

// ---- next-auth v4 adapter models ----
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
